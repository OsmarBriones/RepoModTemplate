{
  "$schema": "http://json.schemastore.org/template",
  "author": "Osmar Briones",
  "classifications": [ "Harmony", "Unity", "BepInEx", "REPO" ],
  "identity": "Repo.ModTemplate",
  "name": "R.E.P.O. BepInEx Mod Template",
  "shortName": "repo-mod",
  "sourceName": "RepoModTemplate",
  "preferNameDirectory": false,
  
  "defaultName": "MyREPOPlugin",
  
  "tags": {
    "language": "C#",
    "type": "project"
  },
  
  "primaryOutputs": [
    { "path": "RepoModTemplate.csproj" }
  ],

  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "external/**",
        "bin/**",
        "obj/**",
        "ts_build/**",
        "Thunderstore/**",
        "dist/**",
        ".vs/**",
        ".git/**",
        ".gitmodules"
      ]
    }
  ],

  "symbols": {
    "AuthorId": {
      "type": "parameter",
      "datatype": "text",
      "description": "Author ID for the GUID (e.g. com.johndoe)",
      "replaces": "AUTHOR_ID",
      "defaultValue": "com.example"
    }
  }
}
